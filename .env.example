# ==============================================================================
# White-Label E-Commerce Solutions - Environment Configuration Template
# Copy this file to .env or .env.local and populate the values for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SITE & CANONICAL DOMAIN (Critical for SEO, Open Graph & Sitemaps)
# ------------------------------------------------------------------------------
# The primary public URL of your website. Used for metadataBase, canonical links,
# sitemap.xml, robots.txt, and social media sharing cards (WhatsApp, Twitter, LinkedIn).
# In production with custom domain: https://solutions.mechatronlab.com
# On Vercel fallback: https://white-label-solutions.vercel.app
NEXT_PUBLIC_SITE_URL=https://white-label-solutions.vercel.app
NEXT_PUBLIC_SITE_NAME="Mechatron Lab Solutions"

# ------------------------------------------------------------------------------
# 2. CONTACT & BUSINESS INFO
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=contact@mechatronlab.com
NEXT_PUBLIC_CONTACT_PHONE="+91-98879-98663"
NEXT_PUBLIC_WHATSAPP_NUMBER="919887998663"
NEXT_PUBLIC_WHATSAPP_PREFILL_TEXT="Hi Mechatron Lab, I am interested in your White-Label E-Commerce Solution."

# ------------------------------------------------------------------------------
# 3. SEARCH ENGINE VERIFICATION & ANALYTICS
# ------------------------------------------------------------------------------
# Google Search Console verification meta tag (content attribute value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools verification meta tag
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager Container ID (optional, format: GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# ------------------------------------------------------------------------------
# 4. LEAD CAPTURE & TEAM NOTIFICATIONS (Demo Booking Modal)
# ------------------------------------------------------------------------------
# Incoming Webhook URL to instantly receive demo requests in Slack, Discord, Zapier, or Make
# Example: Paste your team incoming webhook URL here
LEAD_WEBHOOK_URL=

# Email address where demo bookings and sales inquiries are dispatched
LEAD_NOTIFICATION_EMAIL=sales@mechatronlab.com

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL (Optional - for sending auto-confirmations to customers)
# ------------------------------------------------------------------------------
# Resend API Key (https://resend.com)
RESEND_API_KEY=

# Sender email for automated notifications (must be a verified domain)
EMAIL_FROM="Mechatron Lab Solutions <notifications@mechatronlab.com>"
